import cv2
from ultralytics import YOLO
import time
import numpy as np

model = YOLO("yolov8n.pt")
cap = cv2.VideoCapture("files/person2.mp4")
fps = cap.get(cv2.CAP_PROP_FPS)
delay = int(1000 / fps) if fps > 0 else 33

track_id_counter = 0
max_missed = 15
detection_interval = 5
min_confidence = 0.4

def iou(box1, box2):
    x1, y1, w1, h1 = box1
    x2, y2, w2, h2 = box2
    xi1 = max(x1, x2)
    yi1 = max(y1, y2)
    xi2 = min(x1 + w1, x2 + w2)
    yi2 = min(y1 + h1, y2 + h2)
    inter_area = max(0, xi2 - xi1) * max(0, yi2 - yi1)
    union_area = (w1 * h1) + (w2 * h2) - inter_area
    return inter_area / union_area if union_area != 0 else 0

class Track:
    def __init__(self, bbox, label=""):
        global track_id_counter
        self.id = track_id_counter
        track_id_counter += 1
        self.bbox = bbox
        self.label = label
        self.missed = 0
        self.tracker = cv2.TrackerKCF_create()
        
    def init_tracker(self, frame):
        self.tracker.init(frame, self.bbox)
        
    def update(self, frame):
        success, new_bbox = self.tracker.update(frame)
        if success:
            self.bbox = tuple(map(int, new_bbox))
            self.missed = 0
        else:
            self.missed += 1
        return success

tracks = []
frame_count = 0
fps_counter = 0
fps_text = "FPS: 0"
prev_time = time.time()

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break
    
    frame_count += 1
    fps_counter += 1
    
    if frame_count % detection_interval == 0:
        results = model(frame, conf=min_confidence, iou=0.45)
        boxes = results[0].boxes.xywh.cpu().numpy()
        classes = results[0].boxes.cls.cpu().numpy()
        
        detections = []
        for box, cls in zip(boxes, classes):
            x, y, w, h = box
            x -= w/2
            y -= h/2
            detections.append((int(x), int(y), int(w), int(h), model.names[int(cls)]))
        
        unmatched_detections = list(range(len(detections)))
        unmatched_tracks = list(range(len(tracks)))
        
        matches = []
        for d_idx in unmatched_detections[:]:
            best_iou = 0.3
            best_t_idx = -1
            for t_idx in unmatched_tracks[:]:
                iou_score = iou(detections[d_idx][:4], tracks[t_idx].bbox)
                if iou_score > best_iou:
                    best_iou = iou_score
                    best_t_idx = t_idx
            
            if best_t_idx != -1:
                matches.append((d_idx, best_t_idx))
                unmatched_detections.remove(d_idx)
                unmatched_tracks.remove(best_t_idx)
        
        for d_idx, t_idx in matches:
            x, y, w, h, label = detections[d_idx]
            tracks[t_idx].tracker = cv2.TrackerKCF_create()
            tracks[t_idx].bbox = (x, y, w, h)
            tracks[t_idx].label = label
            tracks[t_idx].init_tracker(frame)
        
        for d_idx in unmatched_detections:
            x, y, w, h, label = detections[d_idx]
            new_track = Track((x, y, w, h), label)
            new_track.init_tracker(frame)
            tracks.append(new_track)
    
    active_tracks = []
    for track in tracks:
        if track.update(frame):
            active_tracks.append(track)
        elif track.missed < max_missed:
            active_tracks.append(track)
    
    tracks = active_tracks
    
    curr_time = time.time()
    if curr_time - prev_time >= 1.0:
        fps_text = f"FPS: {fps_counter}"
        fps_counter = 0
        prev_time = curr_time
    
    display_frame = frame.copy()
    for track in tracks:
        x, y, w, h = track.bbox
        color = (0, 255, 0) if track.missed == 0 else (0, 165, 255)
        cv2.rectangle(display_frame, (x, y), (x+w, y+h), color, 2)
        if track.label:
            cv2.putText(display_frame, track.label, (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
    
    cv2.putText(display_frame, fps_text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 255), 2)
    cv2.imshow("Object Tracking", display_frame)
    if cv2.waitKey(delay) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()