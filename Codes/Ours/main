import cv2
from ultralytics import YOLO
import time
import math
import numpy as np

model = YOLO("yolov8n.pt")
cap = cv2.VideoCapture("files/person1.mp4")

fps = cap.get(cv2.CAP_PROP_FPS)
delay = int(1000 / fps) if fps > 0 else 33

def iou(box1, box2):
    x1, y1, w1, h1 = box1
    x2, y2, w2, h2 = box2
    xi1 = max(x1, x2)
    yi1 = max(y1, y2)
    xi2 = min(x1 + w1, x2 + w2)
    yi2 = min(y1 + h1, y2 + h2)
    inter_area = max(0, xi2 - xi1) * max(0, yi2 - yi1)
    box1_area = w1 * h1
    box2_area = w2 * h2
    union_area = box1_area + box2_area - inter_area
    return inter_area / union_area if union_area != 0 else 0

def center_distance(box1, box2):
    x1, y1, w1, h1 = box1
    x2, y2, w2, h2 = box2
    cx1, cy1 = x1 + w1 / 2, y1 + h1 / 2
    cx2, cy2 = x2 + w2 / 2, y2 + h2 / 2
    return math.hypot(cx1 - cx2, cy1 - cy2)

class Track:
    def __init__(self, tracker, label, bbox):
        self.tracker = tracker
        self.label = label
        self.bbox = bbox
        self.missed = 0
        self.kalman = cv2.KalmanFilter(4, 2)
        self.kalman.measurementMatrix = np.array([[1, 0, 0, 0], [0, 1, 0, 0]], np.float32)
        self.kalman.transitionMatrix = np.array([[1, 0, 1, 0], [0, 1, 0, 1],
                                                 [0, 0, 1, 0], [0, 0, 0, 1]], np.float32)
        self.kalman.processNoiseCov = np.eye(4, dtype=np.float32) * 0.03
        x, y, w, h = bbox
        self.kalman.statePre = np.array([x + w / 2, y + h / 2, 0, 0], dtype=np.float32)

    def predict(self):
        pred = self.kalman.predict()
        cx, cy = int(pred[0]), int(pred[1])
        x, y, w, h = self.bbox
        return (cx - w // 2, cy - h // 2, w, h)

    def correct(self, bbox):
        x, y, w, h = bbox
        cx, cy = x + w / 2, y + h / 2
        self.kalman.correct(np.array([[np.float32(cx)], [np.float32(cy)]]))
        self.bbox = bbox

tracks = []
frame_count = 0
max_missed = 10
match_distance_thresh = 50
prev_time = time.time()

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    frame_count += 1
    if frame_count % 10 == 0:
        results = model(frame)
        boxes = results[0].boxes.xyxy
        classes = results[0].boxes.cls

        for box, cls in zip(boxes, classes):
            x1, y1, x2, y2 = map(int, box.tolist())
            new_box = (x1, y1, x2 - x1, y2 - y1)
            matched = False
            for track in tracks:
                if iou(new_box, track.bbox) > 0.5 or center_distance(new_box, track.bbox) < match_distance_thresh:
                    matched = True
                    track.correct(new_box)
                    track.missed = 0
                    break
            if not matched:
                tracker = cv2.TrackerKCF_create()
                tracker.init(frame, new_box)
                new_track = Track(tracker, model.names[int(cls)], new_box)
                tracks.append(new_track)

    annotated_frame = frame.copy()
    updated_tracks = []

    for track in tracks:
        success, new_bbox = track.tracker.update(frame)
        if success:
            x, y, w, h = [int(v) for v in new_bbox]
            if w > 0 and h > 0:
                track.correct((x, y, w, h))
                cv2.rectangle(annotated_frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
                cv2.putText(annotated_frame, track.label, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
                updated_tracks.append(track)
        else:
            track.missed += 1
            if track.missed < max_missed:
                pred_bbox = track.predict()
                x, y, w, h = [int(v) for v in pred_bbox]
                cv2.rectangle(annotated_frame, (x, y), (x + w, y + h), (255, 255, 0), 2)
                cv2.putText(annotated_frame, track.label + " (pred)", (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 0), 2)
                updated_tracks.append(track)

    tracks = updated_tracks

    curr_time = time.time()
    fps_display = 1 / (curr_time - prev_time)
    prev_time = curr_time
    cv2.putText(annotated_frame, f"FPS: {fps_display:.2f}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 255), 2)

    cv2.imshow("YOLO + KCF + Kalman Tracking", annotated_frame)
    if cv2.waitKey(delay) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
