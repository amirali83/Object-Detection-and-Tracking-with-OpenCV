import cv2
from ultralytics import YOLO
import time
import math

model = YOLO("yolov8n.pt")
cap = cv2.VideoCapture("files/person2.mp4")

fps = cap.get(cv2.CAP_PROP_FPS)
delay = int(1000 / fps) if fps > 0 else 33

def iou(box1, box2):
    x1, y1, w1, h1 = box1
    x2, y2, w2, h2 = box2
    xi1 = max(x1, x2)
    yi1 = max(y1, y2)
    xi2 = min(x1 + w1, x2 + w2)
    yi2 = min(y1 + h1, y2 + h2)
    inter_area = max(0, xi2 - xi1) * max(0, yi2 - yi1)
    box1_area = w1 * h1
    box2_area = w2 * h2
    union_area = box1_area + box2_area - inter_area
    return inter_area / union_area if union_area != 0 else 0

def center_distance(box1, box2):
    x1, y1, w1, h1 = box1
    x2, y2, w2, h2 = box2
    cx1, cy1 = x1 + w1 / 2, y1 + h1 / 2
    cx2, cy2 = x2 + w2 / 2, y2 + h2 / 2
    return math.hypot(cx1 - cx2, cy1 - cy2)

trackers = []
labels = []
bboxes = []
missed_frames = []
frame_count = 0
max_missed = 10
match_distance_thresh = 50

detected_ids = set()

prev_time = time.time()

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    frame_count += 1
    if frame_count % 10 == 0:
        results = model(frame)
        boxes = results[0].boxes.xyxy
        classes = results[0].boxes.cls
        new_trackers = []
        new_labels = []
        new_bboxes = []

        for box, cls in zip(boxes, classes):
            x1, y1, x2, y2 = map(int, box.tolist())
            new_box = (x1, y1, x2 - x1, y2 - y1)
            matched = False
            for existing_box in bboxes:
                if iou(new_box, existing_box) > 0.5 or center_distance(new_box, existing_box) < match_distance_thresh:
                    matched = True
                    break
            if not matched:
                tracker = cv2.TrackerKCF_create()
                tracker.init(frame, new_box)
                new_trackers.append(tracker)
                new_labels.append(model.names[int(cls)])
                new_bboxes.append(new_box)

        trackers.extend(new_trackers)
        labels.extend(new_labels)
        bboxes.extend(new_bboxes)
        missed_frames.extend([0] * len(new_trackers))

    annotated_frame = frame.copy()
    updated_trackers = []
    updated_labels = []
    updated_bboxes = []
    updated_missed = []

    for tracker, label, bbox, missed in zip(trackers, labels, bboxes, missed_frames):
        success, new_bbox = tracker.update(frame)
        if success:
            x, y, w, h = [int(v) for v in new_bbox]
            if w > 0 and h > 0:
                cv2.rectangle(annotated_frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
                cv2.putText(annotated_frame, label, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)
                updated_trackers.append(tracker)
                updated_labels.append(label)
                updated_bboxes.append((x, y, w, h))
                updated_missed.append(0)
        else:
            if missed + 1 < max_missed:
                updated_trackers.append(tracker)
                updated_labels.append(label)
                updated_bboxes.append(bbox)
                updated_missed.append(missed + 1)

    trackers = updated_trackers
    labels = updated_labels
    bboxes = updated_bboxes
    missed_frames = updated_missed

    curr_time = time.time()
    fps_display = 1 / (curr_time - prev_time)
    prev_time = curr_time
    cv2.putText(annotated_frame, f"FPS: {fps_display:.2f}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 255), 2)

    cv2.imshow("YOLO + KCF Tracking", annotated_frame)
    if cv2.waitKey(delay) & 0xFF == ord("q"):
        break

cap.release()
cv2.destroyAllWindows()
