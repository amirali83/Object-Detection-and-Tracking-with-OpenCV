import cv2
import time
from ultralytics import YOLO

model = YOLO('yolov5s.pt')

video_path = "files/person1.mp4"
cap = cv2.VideoCapture(video_path)

frame_count = 0
detect_interval = 10

trackers = []
labels = []
prev_labels = set()
fps_time = time.time()

print("[INFO] Starting detection and tracking... Press 'q' to quit.")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    current_time = time.time()
    fps = 1 / (current_time - fps_time)
    fps_time = current_time

    frame_count += 1
    current_labels = set()

    if frame_count % detect_interval == 0:
        trackers.clear()
        labels.clear()

        results = model(frame)[0]
        for box in results.boxes:
            cls_id = int(box.cls[0])
            conf = float(box.conf[0])
            label = model.names[cls_id]
            x1, y1, x2, y2 = map(int, box.xyxy[0])

            tracker = cv2.legacy.TrackerMOSSE_create()
            tracker.init(frame, (x1, y1, x2 - x1, y2 - y1))
            trackers.append(tracker)
            labels.append(label)
            current_labels.add(label)
    else:
        for tracker, label in zip(trackers, labels):
            success, bbox = tracker.update(frame)
            if success:
                x, y, w, h = map(int, bbox)
                cv2.rectangle(frame, (x, y), (x + w, y + h), (255, 0, 0), 2)
                cv2.putText(frame, label, (x, y - 10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 0, 0), 2)
                current_labels.add(label)

    new_objects = current_labels - prev_labels
    gone_objects = prev_labels - current_labels
    if new_objects:
        print(f"[NEW] Objects entered: {new_objects}")
    if gone_objects:
        print(f"[GONE] Objects left: {gone_objects}")

    prev_labels = current_labels

    cv2.putText(frame, f'FPS: {fps:.2f}', (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 255), 2)

    cv2.imshow('YOLO Detection + MOSSE Tracking', frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
