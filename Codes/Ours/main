import cv2
import time
import uuid
from ultralytics import YOLO

def iou(bbox1, bbox2):
    x1, y1, x2, y2 = bbox1
    x1p, y1p, x2p, y2p = bbox2
    xi1, yi1 = max(x1, x1p), max(y1, y1p)
    xi2, yi2 = min(x2, x2p), min(y2, y2p)
    inter_area = max(0, xi2 - xi1) * max(0, yi2 - yi1)
    area1 = (x2 - x1) * (y2 - y1)
    area2 = (x2p - x1p) * (y2p - y1p)
    union_area = area1 + area2 - inter_area
    return inter_area / union_area if union_area else 0

model = YOLO('yolov5s.pt')
cap = cv2.VideoCapture("files/person3.mp4")

frame_count = 0
detect_interval = 15
fps_time = time.time()
trackers = []

print("[INFO] Detection + Tracking running... Press 'q' to quit.")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    current_time = time.time()
    fps = 1 / (current_time - fps_time)
    fps_time = current_time
    frame_count += 1

    # === Step 1: Update all trackers ===
    updated_trackers = []
    for trk in trackers:
        success, bbox = trk['tracker'].update(frame)
        if success:
            trk['bbox'] = bbox
            updated_trackers.append(trk)
    trackers = updated_trackers  # Remove failed trackers

    # === Step 2: Detect new objects every N frames ===
    if frame_count % detect_interval == 0:
        results = model(frame)[0]
        detections = []
        for box in results.boxes:
            cls_id = int(box.cls[0])
            label = model.names[cls_id]
            x1, y1, x2, y2 = map(int, box.xyxy[0])
            detections.append((label, (x1, y1, x2, y2)))

        # Match detections to trackers
        matched = set()
        for i, (det_label, det_bbox) in enumerate(detections):
            best_iou = 0
            best_trk = None
            for trk in trackers:
                if trk['label'] != det_label:
                    continue
                tx, ty, tw, th = trk['bbox']
                trk_bbox = (tx, ty, tx + tw, ty + th)
                iou_score = iou(det_bbox, trk_bbox)
                if iou_score > best_iou:
                    best_iou = iou_score
                    best_trk = trk
            if best_iou > 0.4 and best_trk:
                x1, y1, x2, y2 = det_bbox
                new_box = (x1, y1, x2 - x1, y2 - y1)
                best_trk['tracker'] = cv2.legacy.TrackerMOSSE_create()
                best_trk['tracker'].init(frame, new_box)
                best_trk['bbox'] = new_box
                matched.add(best_trk['id'])
            else:
                # No match — add new tracker
                x1, y1, x2, y2 = det_bbox
                bbox = (x1, y1, x2 - x1, y2 - y1)
                tracker = cv2.legacy.TrackerMOSSE_create()
                tracker.init(frame, bbox)
                obj_id = str(uuid.uuid4())[:8]
                trackers.append({'id': obj_id, 'label': det_label, 'tracker': tracker, 'bbox': bbox})

    # === Step 3: Draw all active trackers ===
    for trk in trackers:
        x, y, w, h = map(int, trk['bbox'])
        cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)
        cv2.putText(frame, f"{trk['label']} {trk['id']}", (x, y - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

    cv2.putText(frame, f'FPS: {fps:.2f}', (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 255, 255), 2)

    cv2.imshow('Stable YOLO + MOSSE Tracker', frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
